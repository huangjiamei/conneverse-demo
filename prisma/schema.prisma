// Conneverse database schema
// Single-file layout, 详见 model 之间的分区注释

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ═══════════════════════════════════════════════════════════════
//  SHOP · REPAIR ORDER · PART LINE
//  CCC 数据的落地形态。RepairOrder 一份对应一辆车 + 一组 PartLine。
// ═══════════════════════════════════════════════════════════════

// 店铺
model Shop {
  id        String   @id @default(cuid())
  name      String   @unique // "M WORK AUTO BODY KENNY RD"
  createdAt DateTime @default(now())

  repairOrders RepairOrder[]
}

// 维修工单(一份 RO,对应一辆车)
model RepairOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 来源
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])
  cccRoNumber String // "2503006" — CCC 那边的 RO 号

  // 车辆信息:CCC 原始 + 当前值(用户可能改过)
  vehicleYear  Int
  vehicleMake  String // 展开后的全名 "Tesla"、"Honda"(用于 matcher)
  vehicleModel String // "Model X"、"Civic Sedan"
  vehicleRaw   String // "2018 TESL Model X 75D AWD" — CCC 原文

  partLines PartLine[]

  @@unique([shopId, cccRoNumber]) // 同一店同一 RO 不重复导入
  @@index([createdAt])
}

// 一条零件行
model PartLine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  // CCC 原始数据
  cccLineNumber      Int // CCC 里的 Line 号 (5, 70, 79...)
  partTypeRaw        String // "OEM"
  partDescriptionRaw String // CCC 原始描述
  partNumberRaw      String? // CCC 原始号

  // 当前值(用于 matcher,用户可以改)
  partDescription String // 初始 = partDescriptionRaw
  partNumber      String? // 初始 = partNumberRaw
  quantity        Int     @default(1)

  //用户偏好
  selectedPreset String @default("Balanced")

  // 关系
  historicalPurchase HistoricalPurchase? // CCC 里"这家店过去实际怎么买的"
  matchSearches      MatchSearch[] // 用户点查询后的每一次 matcher 调用
  purchaseOrders     PurchaseOrder[] // 用户在我们系统里下的采购单

  @@unique([repairOrderId, cccLineNumber])
  @@index([repairOrderId])
}

// ═══════════════════════════════════════════════════════════════
//  HISTORICAL PURCHASE
//  店铺过去怎么买的,来自 CCC。用于以后的 savings baseline 计算,
//  不参与 matcher 调用。
// ═══════════════════════════════════════════════════════════════

model HistoricalPurchase {
  id         String   @id @default(cuid())
  partLineId String   @unique
  partLine   PartLine @relation(fields: [partLineId], references: [id], onDelete: Cascade)

  vendorName       String? // "eBay" / "Lindsay Honda"
  discountPercent  Decimal?  @db.Decimal(5, 4)
  orderedDate      DateTime?
  expectedDelivery DateTime?
  invoiceDate      DateTime?
  creditDate       DateTime?
  extendedSales    Decimal?  @db.Decimal(10, 2) // 客户被收
  actualCost       Decimal?  @db.Decimal(10, 2) // 店实际付
  remarks          String?
}

// ═══════════════════════════════════════════════════════════════
//  MATCHER RESULTS
//  一条 PartLine 每被查询一次,新建一条 MatchSearch。
//  Candidate 是 matcher 返回的每一条候选(每次搜索大约 10 条)。
// ═══════════════════════════════════════════════════════════════

// 一次 matcher 调用的完整结果
model MatchSearch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 可空: 独立搜索 (/search) 落库时 partLineId=null, 不挂在任何 PartLine 上
  partLineId String?
  partLine   PartLine? @relation(fields: [partLineId], references: [id], onDelete: Cascade)

  // 搜索时用的输入快照(可能跟 partLine 当前值不一样,如果用户之后又改了)
  queryVehicleYear     Int
  queryVehicleMake     String
  queryVehicleModel    String
  queryPartDescription String
  queryPartNumber      String?

  // VCdb 精确追踪 (只有 /search 独立搜索有; RO → PartLine 路径三个都是 null,
  // 因为 RO 单只有字符串车辆信息, 没有 VCdb 关联)
  queryVehicleSubModel   String? // 用户选了 "All submodels" 时为 null
  queryVcdbVehicleId     Int? // 选具体 sub-model 时有值, All 时 null
  queryVcdbBaseVehicleId Int? // /search 两种模式都有值

  // PCdb 分类追踪 (只有 /search autocomplete 选了具体 Part 时有值; 自由文本为 null)
  queryPcdbPartId        Int?
  queryPcdbSubCategoryId Int?
  queryPcdbCategoryId    Int?

  // matcher 返回的摘要(方便列表查询,不用每次解 JSON)
  matcherLabel   Int? // 0 / 1 / null
  labelSource    String? // 'EXACT_MPN_MATCH' 等
  candidateCount Int     @default(0)

  // 完整 matcher 响应(复盘/重跑/调试用)
  rawResponse Json

  candidates       Candidate[]
  optimizerResults OptimizerResult[]

  @@index([partLineId, createdAt])
}

// matcher 返回的每一条候选
model Candidate {
  id            String      @id @default(cuid())
  matchSearchId String
  matchSearch   MatchSearch @relation(fields: [matchSearchId], references: [id], onDelete: Cascade)

  rank       Int // 在返回列表里的位置 (1..N)
  ebayItemId String
  title      String
  price      Decimal @db.Decimal(10, 2)
  currency   String  @default("USD")
  itemUrl    String
  imageUrl   String?
  condition  String?

  candidateLabel Int? // matcher 打的标 (0 / 1 / null)
  labelSource    String? // 'EXACT_MPN_MATCH' / 'NGRAM_FITMENT_REJECT' 等

  purchaseOrder    PurchaseOrder? // 如果用户挑了它下单
  optimizerResults OptimizerResult[]

  optimizerRank         Int?
  optimizerTotal        Float?
  optimizerPriceScore   Float?
  optimizerSpeedScore   Float?
  optimizerQualityScore Float?
  optimizerGateReason   String?

  @@index([matchSearchId, rank])
  @@index([ebayItemId])
  @@index([matchSearchId, optimizerRank])
}

// ═══════════════════════════════════════════════════════════════
//  USER ACTIONS
//  用户在我们系统里做的操作(下单等)。
// ═══════════════════════════════════════════════════════════════

// 用户下的采购单
model PurchaseOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partLineId String
  partLine   PartLine @relation(fields: [partLineId], references: [id])

  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  // 下单时快照(卖家之后改价/下架不影响,会计意义上必须)
  ebayItemId String
  title      String
  price      Decimal @db.Decimal(10, 2)
  currency   String  @default("USD")
  quantity   Int     @default(1)

  // 状态机(先简单,以后扩展)
  status String @default("placed") // placed | ordered | delivered | cancelled

  @@index([partLineId])
}

// 每个 candidate × 每个 preset 的 optimizer 结果缓存
// 用户切 preset 时先查这里, 命中就不用调 matcher rerank
model OptimizerResult {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  preset      String // "sameDayJob" 等

  matchSearchId String // 冗余存, 加速查询
  matchSearch   MatchSearch @relation(fields: [matchSearchId], references: [id], onDelete: Cascade)

  rank         Int?
  total        Float?
  priceScore   Float?
  speedScore   Float?
  qualityScore Float?
  gateReason   String?

  createdAt DateTime @default(now())

  @@unique([candidateId, preset])
  @@index([matchSearchId, preset])
  @@index([candidateId])
}

// ============================================================
// VCdB 参考数据 (只读, 从 Auto Care Association VCdb 导入)
// ============================================================
model VcdbYear {
  id           Int               @id // 对应 VCdb YearID (数值就是年份)
  baseVehicles VcdbBaseVehicle[]
}

model VcdbMake {
  id           Int               @id // 对应 VCdb MakeID
  name         String // MakeName
  baseVehicles VcdbBaseVehicle[]

  @@index([name])
}

model VcdbModel {
  id            Int               @id // 对应 VCdb ModelID
  name          String // ModelName
  vehicleTypeId Int // 5=Car, 6=Truck, 7=Van (只导这三种)
  baseVehicles  VcdbBaseVehicle[]

  @@index([name])
  @@index([vehicleTypeId])
}

model VcdbSubModel {
  id       Int           @id // 对应 VCdb SubModelID
  name     String // SubModelName (e.g., "LE", "XLE")
  vehicles VcdbVehicle[]
}

model VcdbBaseVehicle {
  id       Int           @id // 对应 VCdb BaseVehicleID
  yearId   Int // 直接存年份数字 (从 YearID)
  makeId   Int
  modelId  Int
  year     VcdbYear      @relation(fields: [yearId], references: [id])
  make     VcdbMake      @relation(fields: [makeId], references: [id])
  model    VcdbModel     @relation(fields: [modelId], references: [id])
  vehicles VcdbVehicle[]

  @@index([yearId, makeId, modelId]) // 下拉选择器主索引
  @@index([makeId, yearId])
  @@index([yearId])
}

model VcdbVehicle {
  id            Int             @id // 对应 VCdb VehicleID
  baseVehicleId Int
  subModelId    Int
  baseVehicle   VcdbBaseVehicle @relation(fields: [baseVehicleId], references: [id])
  subModel      VcdbSubModel    @relation(fields: [subModelId], references: [id])

  @@index([baseVehicleId, subModelId])
}

// ═══════════════════════════════════════════════════════════════
//  PCdb REFERENCE (Auto Care Parts Terminology)
//  从本地 MySQL PCdb 导入。Category ↔ SubCategory 通过 PartCategory
//  关联表 (多对多)。scripts/import-pcdb.ts 灌数据。
// ═══════════════════════════════════════════════════════════════

model PcdbCategory {
  id             Int                @id // CategoryID
  name           String // CategoryName
  partCategories PcdbPartCategory[]

  @@index([name])
}

model PcdbSubCategory {
  id             Int                @id // SubCategoryID
  name           String // SubCategoryName
  partCategories PcdbPartCategory[]
  mapping        PcdbToEbayMapping?

  @@index([name])
}

// PCdb SubCategory → eBay category 映射 (初稿, 人工 + LLM 生成)
model PcdbToEbayMapping {
  id              Int             @id @default(autoincrement())
  subCategoryId   Int             @unique
  primaryEbayId   Int? // 可空 (none 类型无映射)
  fallbackEbayIds Int[]           @default([]) // 备选 eBay categoryId 数组
  confidence      String // high / medium / low / none
  note            String?
  subCategory     PcdbSubCategory @relation(fields: [subCategoryId], references: [id])

  @@index([subCategoryId])
}

model PcdbPart {
  id             Int                @id // PartTerminologyID
  name           String // PartTerminologyName
  partCategories PcdbPartCategory[]

  @@index([name])
  // pg_trgm gin 索引, 给 /api/parts/search 的 fuzzy (similarity/ILIKE) 提速
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "idx_pcdbpart_name_trgm")
}

model PcdbPartCategory {
  id            Int             @id @default(autoincrement())
  partId        Int
  categoryId    Int
  subCategoryId Int
  part          PcdbPart        @relation(fields: [partId], references: [id])
  category      PcdbCategory    @relation(fields: [categoryId], references: [id])
  subCategory   PcdbSubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([partId, categoryId, subCategoryId])
  @@index([categoryId, subCategoryId])
}

// ═══════════════════════════════════════════════════════════════
//  eBAY TAXONOMY (Motors > Parts & Accessories 子树)
//  matcher GET /api/taxonomy 拉, scripts/import-ebay-taxonomy.ts 灌。
//  自引用树: level 0 = 拉取的 root (6028)。
// ═══════════════════════════════════════════════════════════════

model EbayCategory {
  id       Int            @id // eBay categoryId
  name     String // categoryName
  parentId Int? // null = 拉取的 root (其真实 parent 在子树外)
  level    Int // 相对 root 的深度, root = 0
  fullPath String // "eBay Motors|Parts & Accessories|..."
  isLeaf   Boolean // 可挂 listing 的叶子分类
  parent   EbayCategory?  @relation("EbayCategoryParent", fields: [parentId], references: [id])
  children EbayCategory[] @relation("EbayCategoryParent")

  @@index([parentId])
  @@index([name])
}
