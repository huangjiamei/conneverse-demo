// VCdb 参考数据模型 (身份层 + 配置层)。scripts/import-vcdb*.ts / import-vcdb-config.py 灌数据。

// ============================================================
// VCdB 参考数据 (只读, 从 Auto Care Association VCdb 导入)
// ============================================================
model VcdbYear {
  id           Int               @id // 对应 VCdb YearID (数值就是年份)
  baseVehicles VcdbBaseVehicle[]
}

model VcdbMake {
  id           Int               @id // 对应 VCdb MakeID
  name         String // MakeName
  baseVehicles VcdbBaseVehicle[]

  @@index([name])
}

model VcdbModel {
  id            Int               @id // 对应 VCdb ModelID
  name          String // ModelName
  vehicleTypeId Int // 5=Car, 6=Truck, 7=Van (只导这三种)
  baseVehicles  VcdbBaseVehicle[]

  @@index([name])
  @@index([vehicleTypeId])
}

model VcdbSubModel {
  id       Int           @id // 对应 VCdb SubModelID
  name     String // SubModelName (e.g., "LE", "XLE")
  vehicles VcdbVehicle[]
}

model VcdbBaseVehicle {
  id       Int           @id // 对应 VCdb BaseVehicleID
  yearId   Int // 直接存年份数字 (从 YearID)
  makeId   Int
  modelId  Int
  year     VcdbYear      @relation(fields: [yearId], references: [id])
  make     VcdbMake      @relation(fields: [makeId], references: [id])
  model    VcdbModel     @relation(fields: [modelId], references: [id])
  vehicles VcdbVehicle[]

  @@index([yearId, makeId, modelId]) // 下拉选择器主索引
  @@index([makeId, yearId])
  @@index([yearId])
}

model VcdbVehicle {
  id            Int             @id // 对应 VCdb VehicleID
  baseVehicleId Int
  subModelId    Int
  baseVehicle   VcdbBaseVehicle @relation(fields: [baseVehicleId], references: [id])
  subModel      VcdbSubModel    @relation(fields: [subModelId], references: [id])

  @@index([baseVehicleId, subModelId])
}

// ═══════════════════════════════════════════════════════════════
//  VCdb 配置层 (发动机/变速/驱动/刹车/车身/货箱/轴距/悬挂/转向/其它)
//  当前 schema: 发动机走 "2" 后缀链 (EngineConfig2 → EngineBase2 → EngineBlock/BoreStroke)。
//  只存原始 ID + 结构外键 (scalar, 不建 relation), 查询用 @@index。
//  VehicleTo* 只导身份层保留的 Vehicle (vehicleTypeId 5/6/7)。scripts/import-vcdb-config.ts 灌数据。
