// 业务领域模型 (店铺/用户/订单/RO/搜索/优化器) + 枚举。

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

// CLAIM = 该店暂无管理员,注册者认领;REPLACE = 更换现任管理员
enum ShopAdminRequestKind {
  CLAIM
  REPLACE
}

enum ShopAdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShopType {
  MECHANICAL
  COLLISION    
}

enum Supplier {
  EBAY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PURCHASED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderCancelReason {
  OUT_OF_STOCK
  PRICE_CHANGED
  SHOP_REQUESTED
  OTHER
}

// ═══════════════════════════════════════════════════════════════
//  SHOP · REPAIR ORDER · PART LINE
//  CCC 数据的落地形态。RepairOrder 一份对应一辆车 + 一组 PartLine。
// ═══════════════════════════════════════════════════════════════

// 店铺
model Shop {
  id        String   @id @default(cuid())
  name      String   @unique // "M WORK AUTO BODY KENNY RD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      ShopType?

  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?                    // 两位州码,如 "CA"
  zip          String?                    // ★ 配送时效/运费按它算,单独成列
  country      String  @default("US")

  repairOrders RepairOrder[]
  adminUserId   String? @unique
  adminUser     User?   @relation("ShopAdmin", fields: [adminUserId], references: [id])
  members       User[]  @relation("ShopMembers")
  adminRequests ShopAdminRequest[]
  searches MatchSearch[]

  purchaseOrders PurchaseOrder[]

  @@index([zip])                          // 按 zip 查/算配送时会用到
}

// 平台管理员:直接写库,最高权限
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewedRequests ShopAdminRequest[] @relation("RequestReviewedByAdmin")
  approvedUsers    User[]             @relation("UserApprovedByAdmin")
}

// 员工:自助注册,需审核
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?

  shopId String                                        // 注册必选所属店铺
  shop   Shop   @relation("ShopMembers", fields: [shopId], references: [id])

  status UserStatus @default(PENDING)

  approvedByUserId  String?
  approvedByUser    User?   @relation("UserApprovedByShopAdmin", fields: [approvedByUserId], references: [id])
  approvedUsers     User[]  @relation("UserApprovedByShopAdmin")
  approvedByAdminId String?
  approvedByAdmin   Admin?  @relation("UserApprovedByAdmin", fields: [approvedByAdminId], references: [id])
  approvedAt        DateTime?

  adminOf  Shop?              @relation("ShopAdmin")    // 反向:该 user 是哪个店的管理员(≤1)
  requests ShopAdminRequest[] @relation("RequestByUser")

  searches MatchSearch[]

  purchaseOrders PurchaseOrder[]

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique          // 只存哈希,不存明文
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// 申请成为店铺管理员(平台管理员审核)
model ShopAdminRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])
  userId String
  user   User   @relation("RequestByUser", fields: [userId], references: [id])

  kind   ShopAdminRequestKind
  status ShopAdminRequestStatus @default(PENDING)
  note   String?

  reviewedByAdminId String?
  reviewedByAdmin   Admin?    @relation("RequestReviewedByAdmin", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([status])
}

// 维修工单(一份 RO,对应一辆车)
model RepairOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 来源
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])
  cccRoNumber String // "2503006" — CCC 那边的 RO 号

  // 车辆信息:CCC 原始 + 当前值(用户可能改过)
  vehicleYear  Int
  vehicleMake  String // 展开后的全名 "Tesla"、"Honda"(用于 matcher)
  vehicleModel String // "Model X"、"Civic Sedan"
  vehicleRaw   String // "2018 TESL Model X 75D AWD" — CCC 原文

  partLines PartLine[]

  @@unique([shopId, cccRoNumber]) // 同一店同一 RO 不重复导入
  @@index([createdAt])
}

// 一条零件行
model PartLine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  // CCC 原始数据
  cccLineNumber      Int // CCC 里的 Line 号 (5, 70, 79...)
  partTypeRaw        String // "OEM"
  partDescriptionRaw String // CCC 原始描述
  partNumberRaw      String? // CCC 原始号

  // 当前值(用于 matcher,用户可以改)
  partDescription String // 初始 = partDescriptionRaw
  partNumber      String? // 初始 = partNumberRaw
  quantity        Int     @default(1)

  //用户偏好
  selectedPreset String @default("Budget")

  // 关系
  historicalPurchase HistoricalPurchase? // CCC 里"这家店过去实际怎么买的"
  matchSearches      MatchSearch[] // 用户点查询后的每一次 matcher 调用
  purchaseOrders     PurchaseOrder[] // 用户在我们系统里下的采购单

  @@unique([repairOrderId, cccLineNumber])
  @@index([repairOrderId])
}

// ═══════════════════════════════════════════════════════════════
//  HISTORICAL PURCHASE
//  店铺过去怎么买的,来自 CCC。用于以后的 savings baseline 计算,
//  不参与 matcher 调用。
// ═══════════════════════════════════════════════════════════════

model HistoricalPurchase {
  id         String   @id @default(cuid())
  partLineId String   @unique
  partLine   PartLine @relation(fields: [partLineId], references: [id], onDelete: Cascade)

  vendorName       String? // "eBay" / "Lindsay Honda"
  discountPercent  Decimal?  @db.Decimal(5, 4)
  orderedDate      DateTime?
  expectedDelivery DateTime?
  invoiceDate      DateTime?
  creditDate       DateTime?
  extendedSales    Decimal?  @db.Decimal(10, 2) // 客户被收
  actualCost       Decimal?  @db.Decimal(10, 2) // 店实际付
  remarks          String?
}

// ═══════════════════════════════════════════════════════════════
//  MATCHER RESULTS
//  一条 PartLine 每被查询一次,新建一条 MatchSearch。
//  Candidate 是 matcher 返回的每一条候选(每次搜索大约 10 条)。
// ═══════════════════════════════════════════════════════════════

// 一次 matcher 调用的完整结果
model MatchSearch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 可空: 独立搜索 (/search) 落库时 partLineId=null, 不挂在任何 PartLine 上
  partLineId String?
  partLine   PartLine? @relation(fields: [partLineId], references: [id], onDelete: Cascade)

  // 搜索时用的输入快照(可能跟 partLine 当前值不一样,如果用户之后又改了)
  queryVehicleYear     Int
  queryVehicleMake     String
  queryVehicleModel    String
  queryPartDescription String
  queryPartNumber      String?

  // VCdb 精确追踪 (只有 /search 独立搜索有; RO → PartLine 路径三个都是 null,
  // 因为 RO 单只有字符串车辆信息, 没有 VCdb 关联)
  queryVehicleSubModel   String? // 用户选了 "All submodels" 时为 null
  queryVcdbVehicleId     Int? // 选具体 sub-model 时有值, All 时 null
  queryVcdbBaseVehicleId Int? // /search 两种模式都有值

  // PCdb 分类追踪 (只有 /search autocomplete 选了具体 Part 时有值; 自由文本为 null)
  queryPcdbPartId        Int?
  queryPcdbSubCategoryId Int?
  queryPcdbCategoryId    Int?

  // matcher 返回的摘要(方便列表查询,不用每次解 JSON)
  matcherLabel   Int? // 0 / 1 / null
  labelSource    String? // 'EXACT_MPN_MATCH' 等
  candidateCount Int     @default(0)

  // 完整 matcher 响应(复盘/重跑/调试用)
  rawResponse Json

  candidates       Candidate[]
  optimizerResults OptimizerResult[]

  userId String?
  user   User?  @relation(fields: [userId], references: [id])
  shopId String?
  shop   Shop?  @relation(fields: [shopId], references: [id])

  @@index([userId])
  @@index([shopId])
  @@index([partLineId, createdAt])
}

// matcher 返回的每一条候选
model Candidate {
  id            String      @id @default(cuid())
  matchSearchId String
  matchSearch   MatchSearch @relation(fields: [matchSearchId], references: [id], onDelete: Cascade)

  rank       Int // 在返回列表里的位置 (1..N)
  ebayItemId String
  title      String
  price      Decimal @db.Decimal(10, 2)
  currency   String  @default("USD")
  itemUrl    String
  imageUrl   String?
  condition  String?

  candidateLabel Int? // matcher 打的标 (0 / 1 / null)
  labelSource    String? // 'EXACT_MPN_MATCH' / 'NGRAM_FITMENT_REJECT' 等

  purchaseOrders   PurchaseOrder[] // 用户挑它下过的单 (退款/取消后可重下, 故非唯一)
  optimizerResults OptimizerResult[]

  optimizerRank         Int?
  optimizerTotal        Float?
  optimizerPriceScore   Float?
  optimizerSpeedScore   Float?
  optimizerQualityScore Float?
  optimizerGateReason   String?

  @@index([matchSearchId, rank])
  @@index([ebayItemId])
  @@index([matchSearchId, optimizerRank])
}

// ═══════════════════════════════════════════════════════════════
//  USER ACTIONS
//  用户在我们系统里做的操作(下单等)。
// ═══════════════════════════════════════════════════════════════

// 用户下的采购单
model PurchaseOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())   // = 下单时间(placed)
  updatedAt DateTime @updatedAt

  // 归属:哪家店、谁下的
  shopId          String
  shop            Shop    @relation(fields: [shopId], references: [id])
  orderedByUserId String?
  orderedByUser   User?   @relation(fields: [orderedByUserId], references: [id])

  // 可选挂到 RO 的 part line(独立搜索下单时为 null)
  partLineId String?
  partLine   PartLine? @relation(fields: [partLineId], references: [id])

  // 选中的候选(offer),可空。
  // 刻意不是 @unique: 同一个 candidate 走到终态 (DELIVERED/CANCELLED/REFUNDED)
  // 之后允许重新下单 —— 涨价/断货退款后店铺往往就是要回来重下这一件。
  // "同时只能有一张活跃单" 由下单接口查 ACTIVE_ORDER_STATUSES 保证。
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  // 供应商无关的商品快照
  supplier        Supplier @default(EBAY)
  supplierName    String?                      // 具体供应商名(线下用,如 "Lindsay Honda")
  supplierItemId  String?                      // 外部 id(线下可能没有)
  supplierItemUrl String?
  externalOrderId String?                      // 供应商真实下单确认号(采购后填)
  title           String
  imageUrl        String?
  quantity        Int      @default(1)
  currency        String   @default("USD")

  // 金钱
  quotedPrice           Decimal  @db.Decimal(10, 2)   // 店铺付你的价
  actualCost            Decimal? @db.Decimal(10, 2)   // 你付供应商的(采购后填);差价 = quoted - actual
  stripePaymentIntentId String?
  amountPaid            Decimal? @db.Decimal(10, 2)
  stripeRefundId        String?
  refundedAmount        Decimal? @db.Decimal(10, 2)

  // 收货快照(下单当时的店铺地址,不随 shop 之后被改而变)
  shipToLine1 String?
  shipToLine2 String?
  shipToCity  String?
  shipToState String?
  shipToZip   String?
  shipToPhone String?

  // 物流
  carrier        String?
  trackingNumber String?
  trackingUrl    String?

  // 状态
  status       OrderStatus        @default(PENDING_PAYMENT)
  cancelReason OrderCancelReason?

  // 各状态时间戳(流转时盖)
  paidAt      DateTime?
  purchasedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  @@index([shopId, status])
  @@index([status])               // 履约队列(查 PAID 待处理)
  @@index([partLineId])
  @@index([candidateId])          // 下单前查"这个 candidate 有没有活跃单"
  @@index([orderedByUserId])      // 员工只看自己的单
}

// 每个 candidate × 每个 preset 的 optimizer 结果缓存
// 用户切 preset 时先查这里, 命中就不用调 matcher rerank
model OptimizerResult {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  preset      String // "sameDayJob" 等

  matchSearchId String // 冗余存, 加速查询
  matchSearch   MatchSearch @relation(fields: [matchSearchId], references: [id], onDelete: Cascade)

  rank         Int?
  total        Float?
  priceScore   Float?
  speedScore   Float?
  qualityScore Float?
  gateReason   String?

  createdAt DateTime @default(now())

  @@unique([candidateId, preset])
  @@index([matchSearchId, preset])
  @@index([candidateId])
}
